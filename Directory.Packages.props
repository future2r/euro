        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
        <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
        <PackageVersion Include="CommunityToolkit.WinUI.Controls.Primitives" Version="8.2.251219" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <PackageVersion Include="AngleSharp" Version="1.8.4" />
        <PackageVersion Include="System.Drawing.Common" Version="10.0.12" />
    </ItemGroup>

</Project>
