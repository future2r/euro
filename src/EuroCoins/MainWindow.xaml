<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EuroCoins.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EuroCoins.Views"
    xmlns:vm="using:EuroCoins.ViewModels">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="True"
            BackRequested="OnBackRequested"
            PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/EuroCoins.png" />
            </TitleBar.IconSource>
            <AutoSuggestBox
                x:Name="SearchBox"
                x:Uid="SearchBox"
                MinWidth="200"
                MaxWidth="480"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.Suggestions}"
                QueryIcon="Find"
                UpdateTextOnSelect="False"
                TextChanged="OnSearchTextChanged"
                QuerySubmitted="OnSearchQuerySubmitted">
                <AutoSuggestBox.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAcceleratorInvoked" />
                </AutoSuggestBox.KeyboardAccelerators>
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SearchSuggestion">
                        <Grid Padding="0,4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="32"
                                Height="32"
                                CornerRadius="16"
                                Visibility="{x:Bind IsCoin}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind Image}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <FontIcon
                                FontSize="16"
                                Glyph="&#xE721;"
                                Visibility="{x:Bind views:XamlFunctions.VisibleIfFalse(IsCoin)}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Meta}"
                                    Visibility="{x:Bind IsCoin}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
        </TitleBar>

        <InfoBar
            x:Name="CollectionInfoBar"
            Grid.Row="1"
            Margin="12,0,12,8"
            IsOpen="False"
            Severity="Error">
            <InfoBar.ActionButton>
                <Button x:Name="RetryButton" x:Uid="Collection_Retry" Click="OnRetryLoadClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="260"
            PaneDisplayMode="Auto"
            ItemInvoked="OnNavigationItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Nav_OverviewItem" Tag="Overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF246;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem x:Uid="Nav_AllItem" Tag="All">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_CirculationItem" Tag="Circulation">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE825;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Nav_CommemorativeItem" Tag="Commemorative">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Navigated="OnFrameNavigated" />
        </NavigationView>
    </Grid>
</Window>
