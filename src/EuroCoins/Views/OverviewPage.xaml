<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EuroCoins.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EuroCoins.ViewModels">

    <ScrollViewer>
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock x:Uid="Overview_Title" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Uid="Overview_Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Progress cards -->
            <ItemsRepeater Margin="0,8,0,0" ItemsSource="{x:Bind ViewModel.Stats}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="12"
                        MinItemWidth="240"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:StatCardViewModel">
                        <Button AutomationProperties.Name="{x:Bind AccessibleName}" Command="{x:Bind OpenCommand}" Style="{StaticResource CardButtonStyle}">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing
                                    Width="64"
                                    Height="64"
                                    Background="{ThemeResource ControlStrongFillColorDisabledBrush}"
                                    IsIndeterminate="False"
                                    Value="{x:Bind Value}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Label}" />
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind PercentText}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Detail}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CountryColumn" Width="2*" />
                    <ColumnDefinition x:Name="RecentColumn" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Progress by country -->
                <Border VerticalAlignment="Top" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <Grid>
                            <TextBlock x:Uid="Overview_ByCountry" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Uid="Overview_ByCountryHint"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </Grid>
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Countries}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout
                                    ItemsStretch="Fill"
                                    MinColumnSpacing="24"
                                    MinItemWidth="300" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CountryProgressViewModel">
                                    <Button AutomationProperties.Name="{x:Bind AccessibleName}" Command="{x:Bind OpenCommand}" Style="{StaticResource RowButtonStyle}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{x:Bind Flag}" Style="{StaticResource FlagImageStyle}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <ProgressBar
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Maximum="100"
                                                Value="{x:Bind Value}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind Label}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- Recently added -->
                <Border
                    x:Name="RecentCard"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="Overview_Recent" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock
                            x:Uid="Overview_NoRecent"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind ViewModel.HasNoRecent, Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Recent}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentCoinViewModel">
                                    <Button AutomationProperties.Name="{x:Bind AccessibleName}" Command="{x:Bind OpenCommand}" Style="{StaticResource RowButtonStyle}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="40" Height="40" CornerRadius="20">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{x:Bind Image}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Text="{x:Bind Meta}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CountryColumn.Width" Value="*" />
                        <Setter Target="RecentColumn.Width" Value="0" />
                        <Setter Target="RecentCard.(Grid.Column)" Value="0" />
                        <Setter Target="RecentCard.(Grid.Row)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </ScrollViewer>
</Page>
